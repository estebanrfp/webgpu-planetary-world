# ── OVGrid environment ────────────────────────────────────────────────────
# Copy to `.env` and fill in. NEVER commit `.env` (it is gitignored).

# ── Blockchain admin / deploy scripts (Node, under blockchain/) ────────────
# All optional: the scripts fall back to a public RPC and read-only behaviour
# when unset, so you only need these to deploy/mint/manage on-chain.
PRIVATE_KEY=                 # deployer/admin wallet private key — WRITES only, keep secret
POLYGON_MAINNET_RPC=         # e.g. https://polygon-mainnet.g.alchemy.com/v2/<key>  (falls back to https://polygon-rpc.com)
POLYGON_AMOY_RPC=            # testnet RPC (optional)
POLYGONSCAN_API_KEY=         # for contract verification (optional)

# ── Frontend (browser) — Pinata IPFS pinning ──────────────────────────────
# Needed ONLY to mint new land/assets (pin metadata + images to IPFS).
# A client-side key is exposed to every visitor, so do NOT bundle it. Inject it
# at runtime via a gitignored `config.local.js` loaded before the app:
#
#     window.OVGRID_PINATA_JWT = '<your pinata jwt>'
#
# Leave it unset to run OVGrid in explore / read-only mode (no minting). The 3D
# world, P2P presence and reading land/assets all work without any key.
